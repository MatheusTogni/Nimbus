# --- Server ---
NODE_ENV=development
PORT=3005
# Comma-separated list of allowed origins (only needed when front and API are on different origins)
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5432/nimbus?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Demo account (shown on the login page) ---
DEMO_EMAIL=demo@nimbus.app
DEMO_PASSWORD=demo1234
DEMO_RESET_HOUR=3
DEMO_TIMEZONE=America/Sao_Paulo
DEMO_MAX_RISKS=60
DEMO_MAX_ACTIONS=300
DEMO_MAX_COMMENTS=300
DEMO_MAX_CATEGORIES=20

# --- Optional real admin, created by `npm run db:seed` only if it does not exist yet ---
ADMIN_ORG_NAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
